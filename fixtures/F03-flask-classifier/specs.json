[
  {
    "kind": "api",
    "claim_id": "c1",
    "claim_type": "classification",
    "steps": [
      {
        "id": "classify",
        "request": {
          "method": "POST",
          "path": "/classify",
          "json": {
            "text": "{{case.input.text}}"
          }
        },
        "assertions": [
          {
            "op": "status_equals",
            "value": 200
          },
          {
            "op": "equals",
            "path": "$.label",
            "value": "{{case.expected.label}}"
          }
        ]
      }
    ],
    "practice_cases": [
      {
        "id": "p1",
        "input": {
          "text": "I love this great place"
        },
        "expected": {
          "label": "positive"
        }
      }
    ],
    "final_cases": [
      {
        "id": "f1",
        "input": {
          "text": "The soup was bland and the bread was poor"
        },
        "expected": {
          "label": "negative"
        }
      },
      {
        "id": "f2",
        "input": {
          "text": "good food but bad service"
        },
        "expected": {
          "label": "positive"
        },
        "boundary": true
      },
      {
        "id": "f3",
        "input": {
          "text": "TERRIBLE, AWFUL and BLAND!"
        },
        "expected": {
          "label": "negative"
        },
        "boundary": true
      }
    ]
  }
]
