# Copy to .env and fill in. `.env` is gitignored; never commit secrets.
# Services read configuration from environment variables only; docker-compose passes
# each service the variables it needs (see docker-compose.yml).

# --- Required -----------------------------------------------------------------
# Organiser sign-in password (API only).
ORGANISER_PASSWORD=
# Signs session cookies (API only). Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Claude API key (worker only). Not needed when LLM_MODE=replay.
ANTHROPIC_API_KEY=
# Read-only GitHub token for rate limits (worker and API). Not needed when REPO_PROVIDER=local.
GITHUB_TOKEN=
# Absolute host path for artifacts; mounted into the worker at the same path.
HOST_ARTIFACT_DIR=

# --- Deployment ---------------------------------------------------------------
# `local` allows session cookies over plain http://localhost. Anything else sets Secure.
APP_ENV=local
# Base URL used when printing invitation links.
PUBLIC_BASE_URL=http://localhost:3000

# --- Database and sessions -----------------------------------------------------
DATABASE_URL=postgresql+asyncpg://hp:hp@postgres:5432/hp
SESSION_TTL_HOURS=12
LINK_TTL_DAYS=7

# --- Models ---------------------------------------------------------------------
DRAFT_MODEL=claude-sonnet-5-5
AUDIT_MODEL=claude-sonnet-5-5
BRIEF_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5
# `live` calls Claude; `replay` uses recorded responses for deterministic fixture runs.
LLM_MODE=live
LLM_TIMEOUT_S=60
AUDIT_MAX_STEPS=12
AUDIT_MAX_TOKENS=60000
AUDIT_TIMEOUT_S=120

# --- Repositories ---------------------------------------------------------------
# `github` or `local` (fixtures and tests).
REPO_PROVIDER=github
LOCAL_REMOTES_DIR=fixtures/remotes

# --- Builds and runs ------------------------------------------------------------
BUILDKIT_HOST=docker-container://buildkit
RAILPACK_VERSION=0.43.0
RUNNER_IMAGE=hackproof-runner:1
RUNNER_VERSION=1
BUILD_TIMEOUT_S=480
RUN_TIMEOUT_S=600
STARTUP_TIMEOUT_S=60
APP_MEMORY=1g
APP_CPUS=1
APP_PIDS_LIMIT=256
RUNNER_MEMORY=2g

# --- Worker ---------------------------------------------------------------------
WATCH_CONCURRENCY=4
HEAVY_CONCURRENCY=1

# --- Logging --------------------------------------------------------------------
LOG_LEVEL=INFO
