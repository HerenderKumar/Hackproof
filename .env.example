# Copy to .env and fill in. `.env` is gitignored; never commit secrets.
# Services read configuration from environment variables only; docker-compose passes
# each service the variables it needs (see docker-compose.yml).

# --- Required -----------------------------------------------------------------
# Organiser sign-in password (API only).
ORGANISER_PASSWORD=
# Signs session cookies (API only). Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# AI Credits gateway key (worker only). Not needed when LLM_MODE=replay.
# Model calls go through the gateway, never straight to Anthropic.
LLM_API_KEY=
# Read-only GitHub token for rate limits (worker and API). Not needed when REPO_PROVIDER=local.
GITHUB_TOKEN=
# Absolute host path for artifacts; mounted into the worker at the same path.
HOST_ARTIFACT_DIR=
# Encrypts the code devices upload in a kickoff scan, at rest (API and worker).
# 64 hex characters. Generate: openssl rand -hex 32
BASELINE_KEY=

# --- Deployment ---------------------------------------------------------------
# `local` allows session cookies over plain http://localhost. Anything else sets Secure.
APP_ENV=local
# Base URL used when printing invitation links.
PUBLIC_BASE_URL=http://localhost:3000
# Lets other devices on the network (a phone) reach the pages; set PUBLIC_BASE_URL to this
# machine's address too, before seeding, so the links point at it.
# WEB_BIND=0.0.0.0

# --- Database and sessions -----------------------------------------------------
DATABASE_URL=postgresql+asyncpg://hp:hp@postgres:5432/hp
SESSION_TTL_HOURS=12
LINK_TTL_DAYS=7
# Per team: claims versions (each drafts tests with the model), retries of a failed draft, and
# final submissions (each is a final run).
MAX_CLAIMS_VERSIONS=20
MAX_REDRAFTS=3
MAX_SUBMISSIONS=10

# --- Models ---------------------------------------------------------------------
# OpenAI-compatible endpoint of the gateway, and the gateway's model IDs.
LLM_BASE_URL=https://api.aicredits.in/v1
DRAFT_MODEL=anthropic/claude-sonnet-5.5
AUDIT_MODEL=anthropic/claude-haiku-5.5
BRIEF_MODEL=anthropic/claude-sonnet-5.5
FAST_MODEL=anthropic/claude-haiku-5.5
# `live` calls the gateway; `record` also saves each reply; `replay` answers from saved replies
# (deterministic, free fixture runs).
LLM_MODE=live
LLM_TIMEOUT_S=60
# Where record mode saves model replies and replay mode reads them (`make drafts`).
LLM_REPLAY_DIR=fixtures/llm
DRAFT_MAX_TOKENS=16000
# Browser tests for UI claims (M11): a second drafting call, on Haiku 5.5 for cost (D-059).
DRAFT_UI_TESTS=true
DRAFT_UI_MODEL=anthropic/claude-haiku-5.5
AUDIT_MAX_STEPS=12
AUDIT_MAX_TOKENS=60000
AUDIT_TIMEOUT_S=120

# --- Repositories ---------------------------------------------------------------
# `github` or `local` (fixtures and tests).
REPO_PROVIDER=github
LOCAL_REMOTES_DIR=fixtures/remotes

# --- Builds and runs ------------------------------------------------------------
BUILDKIT_HOST=docker-container://buildkit
RAILPACK_VERSION=0.43.0
RUNNER_IMAGE=hackproof-runner:1
RUNNER_VERSION=1
BUILD_TIMEOUT_S=480
RUN_TIMEOUT_S=600
STARTUP_TIMEOUT_S=60
APP_MEMORY=1g
APP_CPUS=1
APP_PIDS_LIMIT=256
RUNNER_MEMORY=2g
# A run with UI tests (M11): the runner's process and CPU limits, and Chromium's own sandbox
# (D-058; set false only on a host whose kernel refuses it).
RUNNER_PIDS_LIMIT=512
RUNNER_CPUS=2
RUNNER_BROWSER_SANDBOX=true

# --- Worker ---------------------------------------------------------------------
WATCH_CONCURRENCY=4
HEAVY_CONCURRENCY=1
# Tokenises and compares kickoff baselines in this many processes.
INDEX_CONCURRENCY=1

# --- Kickoff baselines (M9) ----------------------------------------------------
# A scanned part is at most this many bytes as sent; a file at most this many; a whole
# device at most this many.
BASELINE_PART_BYTES=4194304
BASELINE_MAX_FILE_BYTES=1048576
BASELINE_MAX_BYTES=2147483648
MAX_DEVICES=12
# Lines shown around each match.
MATCH_CONTEXT_LINES=5
# The "possibly related" list (stage 5): a code model inside the worker scores rewritten old
# code; nothing is sent out. Pairs at or above the score are listed for a judge to check by eye.
EMBEDDINGS=on
RELATED_MIN_SCORE=0.70

# --- The model door (Prune design) ---------------------------------------------------
# A team's app may call a model during a run through a door of ours that forwards to Prune
# under a per-run budget. Off: a run has no way out at all. Prune holds the provider key in its
# vault (Connect > Providers); PRUNE_API_KEY reaches the worker and each run's door only.
MODEL_DOOR=off
PRUNE_API_KEY=
DOOR_MODELS=gpt-4.1-nano,gpt-4o-mini,gpt-5-nano,claude-haiku-4-5
DOOR_RUN_BUDGET_USD=0.05
DOOR_MAX_CALLS=20
# Outside hosts a team's app may call itself over HTTPS (comma-separated, *.example.com for
# subdomains). Empty: none (D-063).
DOOR_EGRESS_HOSTS=

# --- Logging --------------------------------------------------------------------
LOG_LEVEL=INFO
