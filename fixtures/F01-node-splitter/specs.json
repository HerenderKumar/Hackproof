[
  {
    "kind": "api",
    "claim_id": "c1",
    "claim_type": "calculation",
    "steps": [
      {
        "id": "split",
        "request": {
          "method": "POST",
          "path": "/split",
          "json": {
            "total": "{{case.input.total}}",
            "people": "{{case.input.people}}"
          }
        },
        "assertions": [
          {
            "op": "status_equals",
            "value": 200
          },
          {
            "op": "length_equals",
            "path": "$.shares",
            "value": "{{case.input.people}}"
          },
          {
            "op": "sum_equals",
            "path": "$.shares[*]",
            "value": "{{case.input.total}}",
            "tolerance": 0
          }
        ]
      }
    ],
    "practice_cases": [
      {
        "id": "p1",
        "input": {
          "total": 100,
          "people": 4
        }
      }
    ],
    "final_cases": [
      {
        "id": "f1",
        "input": {
          "total": 100.0,
          "people": 3
        }
      },
      {
        "id": "f2",
        "input": {
          "total": 0.01,
          "people": 2
        },
        "boundary": true
      },
      {
        "id": "f3",
        "input": {
          "total": 1000,
          "people": 7
        },
        "boundary": true
      }
    ]
  }
]
